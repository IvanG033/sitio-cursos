# ==============================================================
#  Configuración del sitio de cursos
#  Copia este archivo como ".env" y llena los datos reales.
#  NUNCA subas el archivo .env a GitHub (ya está excluido).
# ==============================================================

APP_NAME="Academia de Marketing Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de datos MySQL (DreamHost: Panel > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=mysql.tu-dominio.com
DB_PORT=3306
DB_DATABASE=cursos
DB_USERNAME=usuario_mysql
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

# --- Correo (avisos de registro, acceso aprobado, mensajes y contraseñas) ---
# Con el correo de DreamHost: smtp.dreamhost.com, puerto 465, ssl.
# Para cambiar la dirección de envío, solo cambia MAIL_FROM_ADDRESS y MAIL_USERNAME.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.dreamhost.com
MAIL_PORT=465
MAIL_USERNAME=ivan@mkt-innovacion.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ivan@mkt-innovacion.com"
MAIL_FROM_NAME="${APP_NAME}"

# A quién avisar cuando alguien nuevo se registra (si se deja vacío, se usa MAIL_FROM_ADDRESS)
ADMIN_NOTIFY_EMAIL=ivan@mkt-innovacion.com

# --- Reglas de los cursos ---
# Porcentaje mínimo del quiz para aprobar y desbloquear el siguiente módulo
QUIZ_PASS_PERCENT=60
# Tamaño máximo de subida desde el administrador (MB)
MAX_VIDEO_MB=500
MAX_FILE_MB=50

# --- Instalación desde el navegador (sin SSH) ---
# Escribe aquí una clave larga y secreta. Úsala en https://tu-dominio.com/instalar
# para crear las tablas y tu cuenta de administrador. También sirve después para
# aplicar actualizaciones de la base de datos. Si la dejas vacía, /instalar se desactiva.
INSTALL_KEY=
